# Copy to backend/.env and adjust. All variables are optional; defaults resolve to the repo layout.

# Paths (defaults: ../data/raw/creditcard.csv, ../artifacts, ../data/finexa.sqlite3)
# FINEXA_DATA_PATH=../data/raw/creditcard.csv
# FINEXA_ARTIFACTS_DIR=../artifacts
# FINEXA_DATABASE_PATH=../data/finexa.sqlite3

# Comma-separated allowed browser origins. Must be explicit (no "*"): the session cookie needs credentialed CORS.
FINEXA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# Optional overrides of the validation-selected thresholds saved with the model.
# Must satisfy 0 <= review < hold <= 1, otherwise the service reports "not ready".
# FINEXA_REVIEW_THRESHOLD=0.0107
# FINEXA_HOLD_THRESHOLD=0.9737

# Set to false to make /explanation return status "unavailable" (prediction keeps working)
FINEXA_EXPLANATIONS_ENABLED=true

# Replay: which held-out split to replay (test | validation | holdout) and base speed
FINEXA_SIM_SPLIT=test
FINEXA_SIM_BASE_EVENTS_PER_SECOND=5
FINEXA_SIM_BACKGROUND_TASK=true

# Authentication: HttpOnly session cookie + CSRF token
FINEXA_SESSION_HOURS=8
# Set true when served over HTTPS
FINEXA_COOKIE_SECURE=false
# FINEXA_AUTH_REQUIRED=true   # only ever set false in automated tests

FINEXA_LOG_LEVEL=INFO
